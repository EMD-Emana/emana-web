# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Every variable below is SERVER-ONLY on purpose: nothing here is NEXT_PUBLIC_*,
# because anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle
# and must therefore never hold a secret (OWASP A02).
# Parsing and validation happen once in src/lib/env.ts (Zod).
# ---------------------------------------------------------------------------

# Absolute origin of the deployed site. Used for canonical URLs, sitemap,
# robots and Open Graph metadata. No trailing slash.
SITE_URL="http://localhost:3000"

# Inbox that should receive contact-form submissions.
# The API route only validates today; wire your provider in route.ts.
CONTACT_INBOX="hola@example.com"

# Fixed-window rate limit applied to POST /api/contact (OWASP A04).
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="60000"
